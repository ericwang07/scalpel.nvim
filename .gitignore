# Ignore everything by default
*

# Re-include specific directories
!.gitignore
!/README.md

# Lua plugin
!/lua/
!/lua/**

# Rust server
!/server/
!/server/**
server/target/

# Eval - include files, ignore subdirectories
!/eval/
!/eval/*
eval/*/

# Always ignore these
models/
*.DS_Store
__pycache__/
*.pyc